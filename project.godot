; 海岛碰碰球 Native Godot project. Open this file in Godot 4.7+.
config_version=5

[application]
config/name="海岛碰碰球"
config/version="1.0.27"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="BallIslandSurvivalGodot"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.54, 0.77, 0.87, 1)

[autoload]
WindowManager="*res://addons/window_kit/window_policy.gd"
RenderQuality="*res://scripts/render_quality.gd"
StartupSurface="*res://scripts/startup_surface.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=0
window/size/borderless=false
window/size/resizable=false
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[physics]
common/physics_ticks_per_second=120
3d/physics_engine="GodotPhysics3D"
3d/default_gravity=20.0
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.windows="vulkan"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
scaling_3d/mode=0
scaling_3d/scale=1.0
environment/defaults/default_clear_color=Color(0.54, 0.77, 0.87, 1)

[network]
limits/packet_peer_stream/max_buffer_po2=22

[debug]
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_cast=0
